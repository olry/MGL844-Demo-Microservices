DB_URL=sqlite+aiosqlite:////data/hello.db
NATS_URL=nats://nats:4222
NOTIFY_DB_URL=sqlite+aiosqlite:////data/notifications.db
AUTH_DB_URL=sqlite+aiosqlite:////data/auth.db
HELLO_SERVICE_URL=http://hello-service:8001
NOTIFY_SERVICE_URL=http://notification-service:8002
AUTH_SERVICE_URL=http://auth-service:8003
GATEWAY_PORT=8000
HELLO_SERVICE_PORT=8001
NOTIFY_SERVICE_PORT=8002
AUTH_SERVICE_PORT=8003
FRONTEND_PORT=3000
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# JWT : a remplacer par une cle aleatoire (>= 32 octets) en dehors d'un projet pedagogique.
JWT_SECRET=change-me-please-32+characters-of-randomness
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60

# Cache partage (seance 8). Les services y lisent/ecrivent leurs donnees chaudes.
REDIS_URL=redis://redis:6379/0
