@startuml component
title Diagramme de composants : MGL844 Microservices (seance 8)

package "Edge" {
    [Nginx]
}

package "Frontend" {
    [WebUI]
}

package "Gateway (x3 replicas)" {
    [Proxy]
}

package "hello-service" {
    package "Controllers" as HC {
        [HelloHealth]
        [UserController]
    }
    package "Models" as HM {
        [User]
    }
    package "Views" as HV {
        [UserCreate]
        [UserOut]
        [UserGreeting]
    }
    [HelloLifespan]
}

package "notification-service" {
    package "Controllers" as NC {
        [NotifHealth]
        [NotificationController]
    }
    package "Models" as NM {
        [Notification]
    }
    package "Views" as NV {
        [NotificationOut]
    }
    [NotificationLifespan]
}

queue "NATS" as NATS
database "Redis\n(cache partage)" as REDIS
database "hello.db" as DBH
database "notifications.db" as DBN

' Nginx est la porte d'entree : il sert le frontend statique et proxifie /api.
[Nginx] --> [WebUI] : sert le statique (HTTPS)
[WebUI] --> [Nginx] : appels /api/*
[Nginx] --> [Proxy] : load balancing (round-robin sur 3 instances)

[Proxy] --> [UserController] : /hello/*
[Proxy] --> [NotificationController] : /notify/*
[Proxy] --> [HelloHealth] : /hello/health
[Proxy] --> [NotifHealth] : /notify/health

[UserController] --> [User] : create, get, list
[UserController] --> [UserCreate] : valide entree
[UserController] --> [UserOut] : forme sortie
[UserController] --> [UserGreeting] : forme sortie
[UserController] --> REDIS : cache user:{id} (TTL 60s)
[UserController] ..> NATS : publish user.created

[NotificationLifespan] ..> NATS : subscribe user.created
[NotificationLifespan] --> [Notification] : create
[NotificationController] --> [Notification] : list
[NotificationController] --> [NotificationOut] : forme sortie

[User] --> DBH
[Notification] --> DBN

@enduml
