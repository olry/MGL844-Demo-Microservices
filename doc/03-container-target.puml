@startuml 03-container-target
title Target — full system (end of class)

skinparam rectangle {
  BackgroundColor<<svc>>   #E3F2FD
  BorderColor<<svc>>       #1976D2
  BackgroundColor<<infra>> #FFF8E1
  BorderColor<<infra>>     #F57F17
  BackgroundColor<<gw>>    #C8E6C9
  BorderColor<<gw>>        #2E7D32
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor    #F57F17
}
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor    #455A64
}

actor "Buyer"  as buyer
actor "Seller" as seller

rectangle "MGL844-Microservice" {

  rectangle "Gateway\nFastAPI + httpx\n:8000\n(JWT validation)" <<gw>> as gw

  rectangle "AuthService\n:8001"      <<svc>> as auth
  rectangle "CatalogueService\n:8002" <<svc>> as catalogue
  rectangle "AuctionsService\n:8003"  <<svc>> as auctions
  rectangle "WalletService\n:8004"    <<svc>> as wallet
  rectangle "OrdersService\n:8005"    <<svc>> as orders

  database "ump_auth"      as auth_db
  database "ump_catalogue" as catalogue_db
  database "ump_auctions"  as auctions_db
  database "ump_wallets"   as wallet_db
  database "ump_orders"    as orders_db

  rectangle "NATS\npub/sub broker" <<infra>> as nats
}

buyer  --> gw : HTTPS
seller --> gw : HTTPS

gw --> auth      : /auth/*
gw --> catalogue : /catalogue/*
gw --> auctions  : /auctions/*  (HTTP + WS)
gw --> wallet    : /wallet/*
gw --> orders    : /orders/*

auth      --> auth_db      : ORM
catalogue --> catalogue_db : ORM
auctions  --> auctions_db  : ORM
wallet    --> wallet_db    : ORM
orders    --> orders_db    : ORM

catalogue ..> nats : publish product.*
auctions  ..> nats : publish auction.* / bid.*
wallet    ..> nats : publish wallet.*
orders    ..> nats : publish order.*

nats ..> catalogue : subscribe auction.*
nats ..> auctions  : subscribe wallet.* / order.*
nats ..> wallet    : subscribe auction.* / order.*
nats ..> orders    : subscribe wallet.*
@enduml
