@startuml 09-deployment-starter
title Deployment — Starter (Docker Compose, current state)

skinparam node {
  BackgroundColor #ECEFF1
  BorderColor    #455A64
}
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor    #1976D2
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor    #F57F17
}

node "Developer Laptop" {

  node "Docker network: microclass" as net {

    node "nats\nimage: nats:2.10-alpine" as n_nats {
      component "Client port\n0.0.0.0:4222"      as nats_client
      component "Monitoring HTTP\n0.0.0.0:8222"  as nats_mon
    }

    node "hello-service\nFROM python:3.11-slim" as n_hello {
      component "uvicorn app.main:app\n:8001" as hello_app
      database  "hello_data\n(named volume)\n/data/hello.db" as v_hello
    }

    node "gateway\nFROM python:3.11-slim" as n_gw {
      component "uvicorn main:app\n:8000" as gw_app
    }
  }

  actor "Student\n(curl, browser)" as user
}

user --> gw_app    : http://localhost:8000
user --> hello_app : http://localhost:8001 (direct)
user --> nats_mon  : http://localhost:8222

gw_app    --> hello_app   : /hello/* (httpx)
hello_app --> v_hello     : ORM async (aiosqlite)
hello_app --> nats_client : nats-py client\n(nats:4222)

note bottom of net
  Healthchecks chain the startup order:
  nats (healthy) → hello-service (healthy) → gateway.
end note
@enduml
