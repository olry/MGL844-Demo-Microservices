@startuml class
title Diagramme de classes : MGL844 Microservices
left to right direction

' ==== hello-service ====
package "hello-service" {
  class User {
    - id : int
    - name : str
    - created_at : datetime
    + greet() : str
  }

  class UserCreate <<Pydantic>> {
    + name : str
  }

  class UserOut <<Pydantic>> {
    + id : int
    + name : str
    + created_at : datetime
  }

  class UserGreeting <<Pydantic>> {
    + id : int
    + name : str
    + message : str
  }

  class UserController <<Controller>> {
    + create(payload : UserCreate) : UserOut
    + index() : list<UserOut>
    + show(user_id : int) : UserGreeting
  }

  class HelloHealth <<Controller>> {
    + index() : dict
  }

  class HelloLifespan <<lifespan>> {
    + connect_nats()
    + create_tables()
  }
}

' ==== notification-service ====
package "notification-service" {
  class Notification {
    - id : int
    - message : str
    - created_at : datetime
  }

  class NotificationOut <<Pydantic>> {
    + id : int
    + message : str
    + created_at : datetime
  }

  class NotificationController <<Controller>> {
    + index() : list<NotificationOut>
  }

  class NotifHealth <<Controller>> {
    + index() : dict
  }

  class NotificationLifespan <<lifespan>> {
    + connect_nats()
    + subscribe(user.created)
  }

  class handle_user_created <<function>> {
    + handle_user_created(msg) : creates Notification
  }
}

' ==== gateway ====
package "gateway" {
  class Proxy <<Controller>> {
    - ROUTES : dict
    + proxy(service : str, path : str) : Response
    + health() : dict
  }
}

' ==== Relations ====
UserController --> User : utilise
UserController ..> UserCreate : valide
UserController ..> UserOut : retourne
UserController ..> UserGreeting : retourne

NotificationController --> Notification : utilise
NotificationController ..> NotificationOut : retourne
handle_user_created --> Notification : cree
NotificationLifespan ..> handle_user_created : abonne

HelloLifespan --> User : create_all
NotificationLifespan --> Notification : create_all

Proxy ..> UserController : transfere /hello/*
Proxy ..> NotificationController : transfere /notify/*
Proxy ..> HelloHealth : transfere /hello/health
Proxy ..> NotifHealth : transfere /notify/health

@enduml
